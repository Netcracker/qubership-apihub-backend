# Analyze-migration environment files in this skill directory.
# Copy the relevant sections to .env.before and .env.after and fill them in locally.

# ---- .env.after only ----
# One APIHub deployment for both migration IDs.
APIHUB_URL=
# Existing key for migration diagnostics and build source/result archives.
APIHUB_API_KEY=
# Separate viewer key for other documented JSON GETs; optional until needed.
APIHUB_READ_ONLY_API_KEY=
PREV_MIG_ID=
MIG_ID=
BACKEND_BRANCH_AFTER=
BUILD_TASK_CONSUMER_BRANCH_AFTER=

# ---- .env.before only ----
BACKEND_BRANCH_BEFORE=
BUILD_TASK_CONSUMER_BRANCH_BEFORE=

# ---- Both files: required only for targeted database diagnostics ----
# Connection to that side's database snapshot. Use an existing SELECT-only account.
PGHOST=
PGPORT=5432
PGDATABASE=apihub
PGUSER=dev-fe-user
PGPASSWORD=password
DB_SCHEMA=public
PGSSLMODE=prefer
