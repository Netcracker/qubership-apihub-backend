# Analyze-migration environment file.
# .env.before — pre-migration (source) database + branch before migration.
# .env.after  — post-migration environment: APIHub URL, API key, migration ID, branch after migration, DB.

# ---- .env.after only ----
# APIHub base URL.
APIHUB_URL=
# API key for X-API-Key.
APIHUB_API_KEY=
# Migration ID to analyse.
MIGRATION_ID=
# Branch on which the migration ran (e.g. develop or a feature branch).
BRANCH_AFTER=

# ---- .env.before only ----
# Branch before the migration (e.g. main or the previous release branch).
BRANCH_BEFORE=

# ---- Both files ----
# PostgreSQL connection.
PGHOST=
PGPORT=5432
PGDATABASE=apihub
PGUSER=dev-fe-user
PGPASSWORD=password
DB_SCHEMA=public
PGSSLMODE=prefer
